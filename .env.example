# Names only. Copy to .env (gitignored) and fill locally. Never commit real values. Razorpay keys must be rzp_test_ keys.
# The prototype has no language model and reads none of the ANTHROPIC and BS_MODEL lines below; they are the production design (decision T1).
ANTHROPIC_API_KEY=
BS_MODEL_SMALL=claude-haiku-4-5-20251001
BS_MODEL_VISION=claude-haiku-4-5-20251001
BS_MODEL_AGENT=claude-sonnet-5-5
BS_MODEL_CONV=claude-sonnet-5-5
BS_NOW=2026-10-02T10:40:00+05:30
BS_DB=data/world.db
BS_TRUTH_DB=data/truth.db
MERCHANT_MOCK_URL=http://localhost:8000/merchant-mock
# The Razorpay keys are only for the real test-mode stage (R6), which the prototype does not need.
RZP_KEY_ID=
RZP_KEY_SECRET=
# Capability flags (see backend/app/config.py). Set to 1 only when the capability is real.
# RZP_PAYMENTS_LIVE=0
VITE_MODE=snapshot
VITE_API_URL=http://localhost:8000
